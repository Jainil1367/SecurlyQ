# Copy to .env and fill in. .env is git-ignored; this example file is safe to commit.
DATABASE_URL=postgresql+psycopg://securlyq:securlyq_dev@localhost:5432/securlyq
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth. In any non-development environment this MUST be a random 32+ character value
# (the app refuses to start otherwise). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# Optional detection tuning (defaults shown)
# BURST_THRESHOLD=10
# BURST_WINDOW_MINUTES=5
# FAIL_THEN_SUCCESS_THRESHOLD=5
# MULTI_IP_THRESHOLD=3

# Later phases:
# LLM_API_KEY=
