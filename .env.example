# Copy to .env and fill in. .env is git-ignored; this example file is safe to commit.
DATABASE_URL=postgresql+psycopg://securlyq:securlyq_dev@localhost:5432/securlyq
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth. In any non-development environment this MUST be a random 32+ character value
# (the app refuses to start otherwise). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# Optional detection tuning (defaults shown)
# BURST_THRESHOLD=10
# BURST_WINDOW_MINUTES=5
# FAIL_THEN_SUCCESS_THRESHOLD=5
# MULTI_IP_THRESHOLD=3

# LLM explanations via Amazon Bedrock. Default "disabled" = template explanations, no AWS needed.
# To enable, see docs/aws/bedrock-setup.md. AWS credentials come from the AWS credential chain
# (CLI profile locally, IAM role on AWS), NEVER from this file.
LLM_PROVIDER=disabled
# BEDROCK_MODEL_ID=<exact id from the Bedrock console>
# AWS_REGION=us-east-1
# LLM_MAX_OUTPUT_TOKENS=700
# LLM_REQUESTS_PER_HOUR=30
