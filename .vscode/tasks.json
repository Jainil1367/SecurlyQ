{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API: run (port 8000)",
      "type": "shell",
      "command": "uvicorn app.main:app --reload",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "Dashboard: run (port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "Dev: API + dashboard",
      "dependsOn": ["API: run (port 8000)", "Dashboard: run (port 5173)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Test: backend",
      "type": "shell",
      "command": "pytest && ruff check .",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: frontend",
      "type": "shell",
      "command": "npm run typecheck && npm test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
